{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "moduleResolution": "Node",
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "baseUrl": ".",
      "paths": {
        "@kod-psm/*": ["packages/*/src", "services/*/src", "domains/*/src"]
      }
    },
    "include": [],
    "exclude": ["node_modules", "dist"]
  }
  